# ===== Banco de Dados =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gestao_ativos

# ===== Backend =====
# URL de conexão usada pelo backend (substitua os valores conforme o POSTGRES_* acima)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/gestao_ativos
# Segredo que assina os tokens JWT — OBRIGATÓRIO em produção (gere um valor forte)
SECRET_KEY=change-me-in-production
# Expiração do token de acesso em minutos (padrão: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Origens permitidas no CORS, separadas por vírgula. Em produção, use o domínio real.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Caminho da pasta de storage (uploads)
STORAGE_PATH=/app/storage

# ===== Admin inicial (seed) =====
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# ===== Frontend =====
# Base da API. Inclui o prefixo /api. Para desenvolvimento local use:
# http://localhost:8000/api  |  Em produção com nginx: /api (mesma origem)
VITE_API_BASE_URL=/api

# ===== Portas =====
# Portas expostas no host (frontend e API)
FRONTEND_PORT=5173
BACKEND_PORT=8000